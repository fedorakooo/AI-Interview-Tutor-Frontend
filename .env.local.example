# API gateway (nginx) — all REST calls go here
NEXT_PUBLIC_API_BASE_URL=http://localhost

# WebSocket base — must match API host; use wss:// in production
NEXT_PUBLIC_WS_BASE_URL=ws://localhost

# Frontend app URL — used for redirects, sitemap, password-reset docs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable React Query devtools
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true

# Feature flags (set to true to enable)
NEXT_PUBLIC_FEATURE_CODING_INTERVIEW=true
NEXT_PUBLIC_FEATURE_JD_MATCH=true
NEXT_PUBLIC_FEATURE_JD_MATCHER=true
NEXT_PUBLIC_FEATURE_BILLING=true
NEXT_PUBLIC_FEATURE_ADMIN_OPS=true
NEXT_PUBLIC_FEATURE_VOICE_INTERVIEW=false
